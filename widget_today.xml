<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wt_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg_light">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/wt_rn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#5B616B" android:textSize="12sp"/>
      <TextView android:id="@+id/wt_rd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#111318" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/wt_tick" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingLeft="16dp" android:paddingRight="16dp" android:background="@drawable/widget_pill_dark" android:text="Tick next" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
  </LinearLayout>
  <ProgressBar android:id="@+id/wt_rp" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="100" android:progress="0" android:indeterminate="false" android:progressDrawable="@drawable/widget_bar"/>
  <LinearLayout android:id="@+id/wt_run" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="10dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_run_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/wt_ra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#111318" android:textSize="15sp" android:textStyle="bold"/>
      <TextView android:id="@+id/wt_rb" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#5B616B" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/wt_end" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:paddingLeft="16dp" android:paddingRight="16dp" android:background="@drawable/widget_pill_dark" android:text="End" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginRight="6dp">
      <TextView android:id="@+id/wt_pt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#5B616B" android:textSize="12sp"/>
      <ProgressBar android:id="@+id/wt_pb" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" android:max="100" android:indeterminate="false" android:progressDrawable="@drawable/widget_bar"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="6dp">
      <TextView android:id="@+id/wt_ct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#5B616B" android:textSize="12sp"/>
      <ProgressBar android:id="@+id/wt_cb" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" android:max="100" android:indeterminate="false" android:progressDrawable="@drawable/widget_bar"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
